import urllib.parse

# ===================== CONFIG (registre 200 options) =====================
def cmd_config(args):
    sub = args.config_cmd
    if sub == "list":
        code, d = jget("/api/config", auth=False)
        opts = d.get("options", [])
        cat = args.category
        if cat: opts = [o for o in opts if o["category"] == cat]
        cats = d.get("categories", [])
        print(f"{G}✓{N} {len(opts)} option(s)" + (f" ({cat})" if cat else f" sur {len(cats)} catégories"))
        cur = None
        for o in opts:
            if o["category"] != cur:
                cur = o["category"]; print(f"\n{B}{cur}{N}")
            v = o["value"]
            if o.get("secret") and v: v = "••••"
            ch = f" [{', '.join(o['choices'])}]" if o.get("choices") else ""
            print(f"  {o['key']:<34} = {v}{ch}")
            print(f"    {D}{o['desc']}{N}")
    elif sub == "get":
        code, d = jget(f"/api/config/{urllib.parse.quote(args.key)}", auth=False)
        if "error" in d: print(f"{R}✗ {d['error']}{N}")
        else:
            v = d["value"]
            if d.get("secret") and v: v = "••••"
            print(f"{G}✓{N} {d['key']} = {v}")
            print(f"    {D}{d['desc']}{N}")
    elif sub == "set":
        code, body, _ = req("POST", "/api/config", body={"key": args.key, "value": args.value}, ctype="application/json")
        d = json.loads(body) if body else {}
        print(f"{G}✓{N} {d.get('message','')}" if d.get("ok") else f"{R}✗ {d.get('message', d.get('error','échec'))}{N}")
    elif sub == "reset":
        code, body, _ = req("POST", f"/api/config/{urllib.parse.quote(args.key)}/reset", body={}, ctype="application/json")
        d = json.loads(body) if body else {}
        print(f"{G}✓{N} {d.get('message','')}" if d.get("ok") else f"{R}✗ {d.get('message', d.get('error','échec'))}{N}")

# ===================== V10 : hub IA / scaffolds / devops =====================
def cmd_provs(a):
    code, d = jget("/api/ai/providers", auth=False)
    if code != 200: print(f"{R}✗ {d.get('error','échec')}{N}"); return
    lm = d.get("local_models", [])
    print(f"{G}✓{N} {d.get('total_cloud',0)} IA cloud keyless · {d.get('total_local_runtimes',0)} runtimes locaux surveillés")
    print(f"\n{B}Runtimes locaux (auto-détection) :{N}")
    for r in d.get("local", []):
        st = "🟢 en ligne" if r.get("alive") else "⚪ silencieux"
        print(f"  {st:<16} {r['name']:<15} {r['base']}")
        print(f"  {'':<16} {D}{r.get('note','')}{N}")
    if lm:
        print(f"\n{B}Modèles locaux détectés :{N}")
        for m in lm[:20]: print(f"  {C}{m['id']}{N}  ({m['runtime']})")
    print(f"\n{B}Cloud sans clé :{N}")
    seen = set()
    for c in d.get("cloud", []):
        if c["id"] in seen: continue
        seen.add(c["id"])
        print(f"  {c['id']:<36} {D}{c.get('desc','')[:60]}{N}")

def cmd_scaffold(a):
    if a.list:
        code, d = jget("/api/scaffolds", auth=False)
        print(f"{G}✓{N} {len(d.get('scaffolds',[]))} templates :")
        for s in d.get("scaffolds", []):
            print(f"  {C}{s['id']:<12}{N} {s['name']:<28} {D}{s['desc'][:58]}{N}")
        return
    if not a.template:
        print(f"{R}✗ template requis (voir : nercel scaffold --list){N}"); return
    body = {"template": a.template}
    if a.name: body["name"] = a.name
    code, resp, _ = req("POST", "/api/scaffold", body=body, ctype="application/json")
    d = json.loads(resp) if resp else {}
    if code in (200, 202):
        print(f"{G}✓{N} {d.get('name')} ({d.get('framework')}) → port :{d.get('port')} · commit {d.get('commit','')[:7]}")
        h = d.get("hooks") or {}
        if h.get("pre") or h.get("post"): print(f"  hooks : pre={'✓' if h.get('pre_ok') else '✗'} post={'✓' if h.get('post_ok') else '✗'}")
    else:
        print(f"{R}✗ {d.get('error','échec')}{N}")

def cmd_gen(a):
    if not a.kind:
        code, d = jget("/api/generators", auth=False)
        print(f"{G}✓{N} générateurs :")
        for g in d.get("generators", []):
            print(f"  {C}{g['id']:<12}{N} {g['name']:<22} {D}{g['desc'][:56]}{N}")
        return
    body = {"kind": a.kind}
    if a.name: body["name"] = a.name
    if a.framework: body["framework"] = a.framework
    code, resp, _ = req("POST", "/api/generate", body=body, ctype="application/json")
    d = json.loads(resp) if resp else {}
    if code == 200:
        print(f"{G}✓{N} {d.get('file')} généré ({d.get('size')} octets) → {d.get('path')}")
    else:
        print(f"{R}✗ {d.get('error','échec')}{N}")

def cmd_ollama(a):
    import urllib.request as _ur
    def _probe(url):
        try:
            _ur.urlopen(url, timeout=1.5).read(1); return True
        except Exception: return False
    online = _probe("http://127.0.0.1:11434/api/tags")
    import shutil as _sh
    binary = bool(_sh.which("ollama"))
    if a.action == "status" or not a.action:
        print(f"service  : {'🟢 en ligne (:11434)' if online else '⚪ arrêté'}")
        print(f"binaire  : {'✓ installé' if binary else '✗ absent'}")
        if online:
            try:
                with _ur.urlopen("http://127.0.0.1:11434/api/tags", timeout=2) as r:
                    tags = json.loads(r.read()).get("models", [])
                print(f"modèles  : {len(tags)}")
                for m in tags: print(f"  {C}{m.get('name')}{N}")
            except Exception as e: print(f"modèles  : ? ({e})")
        if not online and not binary:
            print(f"\n{Y}Installer :{N}\n  curl -fsSL https://ollama.com/install.sh | sh\n  ollama pull qwen2.5-coder:7b")
        return
    if not binary:
        print(f"{R}✗ ollama absent — installe : curl -fsSL https://ollama.com/install.sh | sh{N}"); return
    import subprocess as _sp, sys as _sys
    if a.action == "install":
        print(f"{Y}→ installation d'Ollama…{N}")
        _sys.exit(_sp.call("curl -fsSL https://ollama.com/install.sh | sh", shell=True))
    if a.action == "pull":
        print(f"{Y}→ ollama pull {a.model}{N}")
        _sys.exit(_sp.call(["ollama", "pull", a.model]))
    if a.action == "serve":
        print(f"{Y}→ ollama serve (arrière-plan){N}")
        _sys.exit(_sp.call("nohup ollama serve >/dev/null 2>&1 &", shell=True))

def main():
    p = argparse.ArgumentParser(prog="nercel", description="CLI NERCEL v10.0 — hub IA 30+ modèles, scaffolds, devops")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    sub.add_parser("whoami").set_defaults(fn=cmd_whoami)
    sub.add_parser("features").set_defaults(fn=cmd_features)
    r = sub.add_parser("register"); r.add_argument("user"); r.add_argument("passwd"); r.add_argument("email",nargs="?"); r.set_defaults(fn=cmd_register)
    l = sub.add_parser("login"); l.add_argument("user"); l.add_argument("passwd"); l.set_defaults(fn=cmd_login)
    d = sub.add_parser("deploy"); d.add_argument("file"); d.add_argument("--name"); d.add_argument("--env",default="Production"); d.set_defaults(fn=cmd_deploy)
    ai = sub.add_parser("ai"); ai.add_argument("prompt"); ai.add_argument("--model"); ai.set_defaults(fn=cmd_ai)
    im = sub.add_parser("image"); im.add_argument("prompt"); im.set_defaults(fn=cmd_image)
    ghr = sub.add_parser("gh-repos"); ghr.set_defaults(fn=cmd_gh_repos)
    ghd = sub.add_parser("gh-deploy"); ghd.add_argument("repo"); ghd.add_argument("--name"); ghd.add_argument("--env"); ghd.set_defaults(fn=cmd_gh_deploy)
    lg = sub.add_parser("logs"); lg.add_argument("-f",action="store_true"); lg.set_defaults(fn=cmd_logs)
    # config (registre 200 options)
    cf = sub.add_parser("config"); cf_sub = cf.add_subparsers(dest="config_cmd", required=True)
    cfl = cf_sub.add_parser("list"); cfl.add_argument("--cat", dest="category"); cfl.set_defaults(fn=cmd_config)
    cfg = cf_sub.add_parser("get"); cfg.add_argument("key"); cfg.set_defaults(fn=cmd_config)
    cfs = cf_sub.add_parser("set"); cfs.add_argument("key"); cfs.add_argument("value"); cfs.set_defaults(fn=cmd_config)
    cfr = cf_sub.add_parser("reset"); cfr.add_argument("key"); cfr.set_defaults(fn=cmd_config)
    ag = sub.add_parser("agent"); ag_sub = ag.add_subparsers(dest="agent_cmd", required=True)
    ag_sub.add_parser("list").set_defaults(fn=cmd_agent_list)
    ac = ag_sub.add_parser("create"); ac.add_argument("--name",required=True); ac.add_argument("--system"); ac.add_argument("--model",default="auto"); ac.set_defaults(fn=cmd_agent_create)
    agc = ag_sub.add_parser("chat"); agc.add_argument("id",type=int); agc.add_argument("message"); agc.set_defaults(fn=cmd_agent_chat)
    agd = ag_sub.add_parser("delete"); agd.add_argument("id",type=int); agd.set_defaults(fn=cmd_agent_delete)
    # v10
    pv = sub.add_parser("provs"); pv.set_defaults(fn=cmd_provs)
    sc = sub.add_parser("scaffold"); sc.add_argument("template",nargs="?"); sc.add_argument("--name"); sc.add_argument("--list",action="store_true"); sc.set_defaults(fn=cmd_scaffold)
    gn = sub.add_parser("gen"); gn.add_argument("kind",nargs="?"); gn.add_argument("--name"); gn.add_argument("--framework"); gn.set_defaults(fn=cmd_gen)
    ol = sub.add_parser("ollama"); ol.add_argument("action",nargs="?",choices=["status","install","pull","serve"]); ol.add_argument("--model",default="qwen2.5-coder:7b"); ol.set_defaults(fn=cmd_ollama)
    args = p.parse_args()
    args.fn(args)

if __name__ == "__main__":
    main()
