#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NERCEL v10.0 — CLI
Commandes :
  nercel register <user> <pass> [email]
  nercel login <user> <pass>
  nercel whoami
  nercel status
  nercel list
  nercel deploy <zip> [--name X] [--env Production]
  nercel ai "question"            # GLM Flash
  nercel image "prompt"           # Pollinations → ouvre l'image
  nercel gh-repos                 # dépôts GitHub connectés
  nercel gh-deploy <repo_url> [--name X]
  nercel logs [-f]
  nercel features
"""
import sys, os, json, urllib.request, urllib.error, argparse, time, webbrowser

API = os.environ.get("NERCEL_API", "http://127.0.0.1:3923")
EDGE = os.environ.get("NERCEL_EDGE", "http://127.0.0.1:8765")
DATA = os.environ.get("NERCEL_DATA", os.path.expanduser("~/.nercel"))
TOKEN_FILE = os.path.join(DATA, "cli_token")

G="\033[0;32m"; R="\033[0;31m"; Y="\033[1;33m"; C="\033[0;36m"; D="\033[2m"; B="\033[1m"; N="\033[0m"

def save_token(t):
    os.makedirs(DATA, exist_ok=True)
    open(TOKEN_FILE,"w").write(t); os.chmod(TOKEN_FILE, 0o600)

def token():
    try: return open(TOKEN_FILE).read().strip()
    except Exception: return None

def req(method, path, body=None, ctype=None, with_auth=True):
    url = API + path
    data = body if isinstance(body, bytes) else (body.encode() if isinstance(body,str) else (json.dumps(body).encode() if body else None))
    r = urllib.request.Request(url, data=data, method=method)
    if ctype: r.add_header("Content-Type", ctype)
    if with_auth:
        t = token()
        if t: r.add_header("Cookie", f"nercel_session={t}")
    try:
        with urllib.request.urlopen(r, timeout=60) as resp:
            tk = None
            for h in resp.headers.get_all("Set-Cookie") or []:
                if "nercel_session=" in h:
                    tk = h.split("nercel_session=")[1].split(";")[0]
            return resp.status, resp.read(), tk
    except urllib.error.HTTPError as e:
        return e.code, e.read(), None
    except Exception as e:
        return 0, str(e).encode(), None

def jget(path, auth=True):
    code, body, _ = req("GET", path, with_auth=auth)
    if code == 0:
        print(f"{R}orchestrateur injoignable ({API}). Lance : bash start.sh{N}"); sys.exit(1)
    try: return code, json.loads(body)
    except Exception: return code, {}

# ---------- commandes ----------
def cmd_register(a):
    body = json.dumps({"username":a.user,"password":a.passwd,"email":a.email or ""}).encode()
    code, resp, tk = req("POST","/api/auth/register",body,"application/json",with_auth=False)
    if code==201 and tk: save_token(tk); print(f"{G}✓ compte créé, connecté{N}")
    else: print(f"{R}échec ({code}){N} {resp.decode('utf-8','ignore')}"); sys.exit(1)

def cmd_login(a):
    body = json.dumps({"username":a.user,"password":a.passwd}).encode()
    code, resp, tk = req("POST","/api/auth/login",body,"application/json",with_auth=False)
    if code==200 and tk:
        save_token(tk); print(f"{G}✓ connecté{N}  (token sauvé dans {TOKEN_FILE})")
    else:
        print(f"{R}identifiants invalides{N}"); sys.exit(1)

def cmd_whoami(a):
    code, d = jget("/api/auth/me")
    u = d.get("user")
    if u: print(f"{C}connecté{N}  {u['username']}  (id {u['id']})  {u.get('email','')}")
    else: print(f"{D}non connecté — nercel login <user> <pass>{N}")

def cmd_status(a):
    code, d = jget("/api/status", auth=False)
    u = d.get("user")
    print(f"{C}NERCEL v10.0{N}  user={u['username'] if u else '(anonyme)'}")
    print(f"  projets      : {len(d.get('projects',[]))}  ({d.get('running',0)} running)")
    print(f"  déploiements : {d.get('deployments',0)}")
    print(f"  CPU/RAM      : {d.get('cpu',0)}% / {d.get('ram',0)}%")
    print(f"  requêtes     : {d.get('requests',0)}")
    print(f"  features     : {d.get('features',0)}")

def cmd_list(a):
    code, d = jget("/api/projects")
    projs = d.get("projects",[])
    if not projs: print(f"{D}aucun projet{N}"); return
    print(f"{C}{'NOM':<18}{'FW':<10}{'STATUS':<10}URL{N}")
    for p in projs:
        sc = G if p["status"]=="running" else D
        print(f"{p['name']:<18}{p.get('framework','?'):<10}{sc}{p['status']:<10}{N}{EDGE}/{p['name']}/")

def cmd_deploy(a):
    if not os.path.exists(a.file): print(f"{R}fichier introuvable{N}"); sys.exit(1)
    name = a.name or os.path.splitext(os.path.basename(a.file))[0]
    b = f"nercel{int(time.time()*1000)}".encode()
    body = (f"--{b.decode()}\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\n{name}\r\n"
            f"--{b.decode()}\r\nContent-Disposition: form-data; name=\"env\"\r\n\r\n{a.env}\r\n"
            f"--{b.decode()}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{os.path.basename(a.file)}\"\r\n"
            f"Content-Type: application/zip\r\n\r\n").encode()
    body += open(a.file,"rb").read()
    body += f"\r\n--{b.decode()}--\r\n".encode()
    code, resp, _ = req("POST","/api/deploy",body,f"multipart/form-data; boundary={b.decode()}")
    if code==202:
        d=json.loads(resp)
        print(f"{G}✓ déployé{N}  {d['name']} ({d['framework']})  :{d['port']}  {d['commit']}")
        print(f"  edge : {EDGE}/{d['name']}/")
    else: print(f"{R}échec ({code}){N} {resp.decode('utf-8','ignore')}"); sys.exit(1)

def cmd_ai(a):
    code, d = jget("/api/auth/me")
    payload = {"messages":[{"role":"user","content":a.prompt}]}
    if getattr(a, "model", None): payload["model"] = a.model
    body = json.dumps(payload).encode()
    code, resp, _ = req("POST","/api/ai/chat",body,"application/json",with_auth=False)
    if code==200:
        d=json.loads(resp)
        print(f"{C}[{d.get('provider') or d.get('model','?')}]{N}\n")
        print(d["reply"])
    else: print(f"{R}échec ({code}){N} {resp.decode('utf-8','ignore')}")

def cmd_image(a):
    code, resp, _ = req("GET","/api/ai/image?prompt="+urllib.parse.quote(a.prompt), with_auth=False)
    if code==200:
        d=json.loads(resp); url=API+d["image"]
        print(f"{G}✓ image générée{N}  {url}  ({d['size']} octets)")
        try: webbrowser.open(url)
        except Exception: pass
    else: print(f"{R}échec{N}")

def cmd_gh_repos(a):
    code, d = jget("/api/github/repos")
    repos = d.get("repos",[])
    if d.get("connected") is False: print(f"{R}GitHub non connecté{N}"); sys.exit(1)
    if not repos: print(f"{D}aucun dépôt{N}"); return
    print(f"{C}{'DÉPÔT':<28}{'LANG':<10}⭐  URL{N}")
    for r in repos:
        print(f"{r['name'][:26]:<28}{(r['lang'] or '—'):<10}{r['stars']:<3} {r['url']}")

def cmd_gh_deploy(a):
    name = a.name or a.repo.rstrip("/").split("/")[-1].replace(".git","")
    body = json.dumps({"repo_url":a.repo,"name":name,"env":a.env or "Production"}).encode()
    code, resp, _ = req("POST","/api/github/deploy",body,"application/json")
    if code==202:
        d=json.loads(resp)
        print(f"{G}✓ cloné+déployé{N}  {d['name']} ({d['framework']})  :{d['port']}")
        print(f"  edge : {EDGE}/{d['name']}/")
    else: print(f"{R}échec ({code}){N} {resp.decode('utf-8','ignore')}"); sys.exit(1)

def cmd_logs(a):
    if not a.f:
        code, d = jget("/api/logs")
        for l in d.get("logs",[]):
            c={"info":C,"warn":Y,"err":R}.get(l.get("level","info"),N)
            print(f"{D}{l.get('ts','')}{N} {c}{l.get('level','').upper()[:4]:<4}{N} {l.get('msg','')}")
        return
    url = API+"/api/logs/stream"
    try:
        r = urllib.request.urlopen(url, timeout=None)
        buf=b""
        while True:
            ch = r.read(1)
            if not ch: break
            buf += ch
            if buf.endswith(b"\n\n"):
                for line in buf.split(b"\n"):
                    if line.startswith(b"data: "):
                        try:
                            l=json.loads(line[6:])
                            c={"info":C,"warn":Y,"err":R}.get(l.get("level","info"),N)
                            print(f"{D}{l.get('ts','')}{N} {c}{l.get('level','').upper()[:4]:<4}{N} {l.get('msg','')}")
                        except Exception: pass
                buf=b""
    except KeyboardInterrupt: print("\nstop.")

def cmd_features(a):
    code, d = jget("/api/features", auth=False)
    sprints={}
    for f in d.get("features",[]): sprints.setdefault(f.get("sprint",0),[]).append(f)
    for sp in sorted(sprints):
        items=sprints[sp]
        print(f"\n{C}Sprint {sp} ({len(items)}){N}")
        for f in items:
            ic = G if f["status"]=="active" else Y
            sym = "●" if f["status"]=="active" else "◐"
            print(f"  {ic}{sym}{N} #{f['id']:>2} {f['name']}")
    print(f"\n{G}Total : {d.get('total',0)} fonctionnalités en 4 sprints{N}")

