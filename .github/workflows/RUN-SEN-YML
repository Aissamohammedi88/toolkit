      - name: Run Semgrep
        uses: semgrep/semgrep-action@v1
        with:

          config: >-
            p/secrets
            p/security-audit
            p/owasp-top-ten
          generateSarif: "1"
        env:

          SEMGREP_APP_TOKEN: ${{ secrets.SEMGREP_APP_TOKEN }}
      - name: Upload SARIF file
        uses: github/codeql-action/upload-sarif@v3
        if: always()
        with:
          sarif_file: semgrep.sarif
          category: semgrep
