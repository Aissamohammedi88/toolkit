name: Quality Gate
on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
jobs:
  lint-and-type:
    name: "Lint & Type Check"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
      - name: Install Tools
        run: |
          pip install ruff mypy
      - name: Run Ruff (Linting)
        run: ruff check .

      - name: Run Ruff (Formatting)
        run: ruff format --check .

      - name: Run Mypy (Typing)
        run: mypy office/ --ignore-missing-imports
